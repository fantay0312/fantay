    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.2",
    "jspdf": "4.2.1",
    "lexical": "0.36.2",
    "lucide-react": "1.16.0",
    "micromark": "4.0.2",
    "micromark-extension-gfm": "3.0.0",
    "motion": "12.40.0",
    "next": "16.2.6",
