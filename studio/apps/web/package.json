{
  "name": "@open-design/web",
  "version": "0.25.1",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./sidecar": {
      "types": "./dist/sidecar/index.d.ts",
      "default": "./dist/sidecar/index.js"
    }
  },
  "files": [
    ".next",
    "!.next/cache",
    "app",
    "dist",
    "next.config.ts",
    "package.json",
    "public",
    "src"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm --filter @fantay/canvas build && next build && tsc -b --noEmit",
    "build:sidecar": "tsc -p tsconfig.sidecar.json",
    "typecheck": "next typegen && tsc -b --noEmit",
    "test": "vitest run -c vitest.config.ts --maxWorkers=2"
  },
  "dependencies": {
